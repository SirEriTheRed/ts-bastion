# Normalize line endings (LF on checkout/commit)
* text=auto eol=lf

# Sources
*.ts text linguist-language=TypeScript diff=typescript
*.mts text
*.cts text
*.js text linguist-language=JavaScript
*.mjs text
*.cjs text
*.json text
*.jsonc text
*.yml text
*.yaml text
*.md text diff=markdown
*.mdx text
*.html text diff=html
*.css text
*.svg text
*.sh text eol=lf

# Binaires
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
*.zip binary
*.gz binary

# Linguist — generated files
dist/** linguist-generated=true
docs/** linguist-generated=true
reports/** linguist-generated=true
coverage/** linguist-generated=true
package-lock.json linguist-generated=true
dependency-graph.svg linguist-generated=true

# Archive — excluded from git archive / export-ignore
.gitattributes export-ignore
.gitignore export-ignore
.github/ export-ignore
.husky/ export-ignore
tests/ export-ignore
reports/ export-ignore
.vscode/ export-ignore
.editorconfig export-ignore
.prettierignore export-ignore
cspell.json export-ignore
knip.json export-ignore
typedoc.json export-ignore
typedoc.html.json export-ignore

# Merge
package-lock.json merge=binary
