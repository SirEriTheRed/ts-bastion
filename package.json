{
  "name": "@erithered/ts-bastion",
  "version": "0.0.0",
  "private": true,
  "description": "A typescript project template centered around code quality and CI/CD",
  "keywords": [
    "typescript",
    "template",
    "quality",
    "ci-cd"
  ],
  "homepage": "https://github.com/SirEriTheRed/ts-bastion#readme",
  "bugs": {
    "url": "https://github.com/SirEriTheRed/ts-bastion/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SirEriTheRed/ts-bastion.git"
  },
  "license": "MIT",
  "author": "erithered",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "actionlint": "actionlint -color",
    "actionlint:docker": "docker run --rm -v $(pwd):/repo --workdir /repo rhysd/actionlint:1.7.12 -color",
    "analyze": "knip",
    "audit:signatures": "npm audit signatures",
    "audit:signatures:warn": "npm audit signatures || true",
    "build": "tsc",
    "check": "npm run lint && npm run lint:package && npm run type-check && npm run type-check:tests && npm run format:check && npm run editorconfig && npm run ls-lint && npm run knip && npm run depcruise",
    "clean": "rm -rf dist",
    "cleanup": "rm -rf dist reports .nyc_output tmp temp .cache *.tsbuildinfo",
    "codeql": "bash scripts/codeql-scan.sh",
    "commit": "cz",
    "depcruise": "depcruise src --output-type err-long",
    "depcruise:graph": "depcruise src --include-only '^src' --output-type dot | dot -T svg > dependency-graph.svg",
    "depcruise:html": "mkdir -p reports/depcruiser && depcruise src --output-type err-html --output-to reports/depcruiser/index.html",
    "dev": "tsc --watch",
    "docs": "rm -rf docs && typedoc",
    "docs:html": "typedoc --options typedoc.html.json",
    "docs:watch": "typedoc --watch",
    "editorconfig": "editorconfig-checker",
    "editorconfig:docker": "docker run --rm --volume=$PWD:/check mstruebing/editorconfig-checker",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "licenses": "license-checker",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:package": "npmPkgJsonLint .",
    "lint:spell": "cspell lint \"**/*.{ts,md,json}\" --no-progress",
    "lockfile-lint": "lockfile-lint --type npm --path package-lock.json --allowed-hosts npm --validate-https --validate-integrity --empty-hostname false",
    "ls-lint": "ls-lint",
    "osv": "osv-scanner scan source -r .",
    "osv:html": "mkdir -p reports && osv-scanner scan source -r . --format html --output-file reports/osv-report.html",
    "osv:html:force": "mkdir -p reports && osv-scanner scan source -r . --format html --output-file reports/osv-report.html || true",
    "package:sort": "sort-package-json",
    "prepare": "husky",
    "release": "semantic-release",
    "release:dry": "semantic-release --dry-run",
    "sbom": "mkdir -p reports/sbom && npm sbom --sbom-format spdx --package-lock-only > reports/sbom/sbom.spdx.json",
    "sbom:all": "npm run sbom && npm run sbom:cyclonedx",
    "sbom:cyclonedx": "mkdir -p reports/sbom && npm sbom --sbom-format cyclonedx --package-lock-only > reports/sbom/sbom.cyclonedx.json",
    "sbom:validate": "npx --yes @cyclonedx/cyclonedx-cli validate --input-file reports/sbom/sbom.cyclonedx.json 2>/dev/null || node -e \"JSON.parse(require('fs').readFileSync('reports/sbom/sbom.cyclonedx.json','utf8')); console.log('SBOM valid JSON')\" || true",
    "secretlint": "secretlint \"**/*\"",
    "secretlint:mask": "secretlint --maskSecrets \"**/*\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:coverage:watch": "vitest --coverage",
    "test:ui": "vitest --ui",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "type-check:tests": "tsc --noEmit -p tsconfig.test.json",
    "zizmor": "zizmor .",
    "zizmor:sarif": "mkdir -p reports && zizmor --format sarif . > reports/zizmor.sarif"
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@commitlint/cz-commitlint": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@eslint/markdown": "^8.0.3",
    "@ls-lint/ls-lint": "2.3.1",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.5",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/npm": "^13.1.5",
    "@types/node": "^20.19.42",
    "@vitest/coverage-v8": "4.1.11",
    "@vitest/eslint-plugin": "^1.6.27",
    "commitizen": "^4.3.2",
    "commitlint": "^21.0.2",
    "cspell": "^10.0.1",
    "cz-conventional-changelog": "^3.3.0",
    "dependency-cruiser": "^18.2.0",
    "editorconfig-checker": "7.0.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.0",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-regexp": "^3.3.0",
    "eslint-plugin-security": "^4.0.0",
    "eslint-plugin-sonarjs": "^4.0.3",
    "eslint-plugin-tsdoc": "^0.5.2",
    "eslint-plugin-unicorn": "55.0.0",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "inquirer": "^9.3.8",
    "knip": "^6.16.1",
    "license-checker": "^25.0.1",
    "lint-staged": "^17.0.7",
    "lockfile-lint": "^5.0.1",
    "npm-package-json-lint": "11.0.0",
    "prettier": "^3.8.3",
    "secretlint": "^13.0.5",
    "semantic-release": "^25.0.5",
    "sort-package-json": "^4.0.0",
    "typedoc": "^0.28.19",
    "typedoc-plugin-markdown": "^4.12.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.62.0",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "allowScripts": {
    "editorconfig-checker@7.0.0": true,
    "unrs-resolver@1.12.2": true
  }
}
