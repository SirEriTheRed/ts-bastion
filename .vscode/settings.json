{
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "editor.rulers": [100],
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.detectIndentation": false,
  "editor.trimAutoWhitespace": true,
  "editor.guides.bracketPairs": true,
  "editor.bracketPairColorization.enabled": true,
  "editor.inlineSuggest.enabled": true,
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "files.trimFinalNewlines": true,
  "files.exclude": {
    "dist/": true,
    "reports/": true,
    "coverage/": true,
    ".nyc_output/": true
  },
  "search.exclude": {
    "dist/": true,
    "reports/": true,
    "coverage/": true,
    ".nyc_output/": true,
    "node_modules/": true,
    "package-lock.json": true
  },
  "files.watcherExclude": {
    "**/dist/**": true,
    "**/reports/**": true,
    "**/coverage/**": true,
    "**/.nyc_output/**": true,
    "**/node_modules/**": true
  },
  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "files.trimTrailingWhitespace": false,
    "editor.wordWrap": "on"
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[yaml]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "eslint.enable": true,
  "eslint.useFlatConfig": true,
  "eslint.validate": ["javascript", "javascriptreact", "typescript", "typescriptreact", "markdown"],
  "eslint.workingDirectories": [{ "mode": "auto" }],
  "eslint.codeActionsOnSave.mode": "all",
  "eslint.options": {
    "overrideConfigFile": "eslint.config.js"
  },
  "eslint.rules.customizations": [],
  "prettier.requireConfig": true,
  "prettier.useEditorConfig": true,
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "typescript.preferences.importModuleSpecifier": "relative",
  "typescript.preferences.quoteStyle": "single",
  "typescript.preferences.importModuleSpecifierEnding": "js",
  "typescript.suggest.autoImports": true,
  "typescript.updateImportsOnFileMove.enabled": "always",
  "typescript.inlayHints.parameterNames.enabled": "none",
  "cSpell.enabled": true,
  "cSpell.allowCompoundWords": true,
  "cSpell.enableFiletypes": ["markdown", "plaintext", "typescript", "javascript", "json", "yaml"],
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.fileNesting.patterns": {
    "package.json": "package-lock.json, .nvmrc, .editorconfig, .prettierrc, .prettierignore, eslint.config.js, tsconfig*.json, vitest.config.ts, knip.json, cspell.json, .ls-lint.yml, .editorconfig-checker.json, typedoc.json, typedoc.html.json",
    "tsconfig.json": "tsconfig.test.json",
    ".eslintrc*": "eslint.config.js"
  },
  "vitest.enable": true,
  "vitest.commandLine": "npm test --",
  "yaml.schemas": {
    "https://json.schemastore.org/github-workflow": ".github/workflows/*.yml"
  },
  "yaml.format.enable": true,
  "markdown.preview.breaks": false,
  "markdown.updateLinksOnFileMove.enabled": "prompt"
}
