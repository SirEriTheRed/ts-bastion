{
  "project": ["**/*.ts"],
  "ignoreDependencies": [
    "@secretlint/secretlint-rule-preset-recommend",
    "@semantic-release/npm",
    "cz-conventional-changelog",
    "globals"
  ],
  "ignoreBinaries": ["actionlint", "dot", "osv-scanner", "reuse", "zizmor"],
  "rules": {
    "files": "error",
    "dependencies": "error",
    "devDependencies": "error",
    "unlisted": "error",
    "exports": "error"
  }
}
